# Keystore configuration for release builds
# Copy this file to keystore.properties and fill in your actual values
# NEVER commit keystore.properties to version control

# Path to your keystore file (relative to project root)
storeFile=path/to/your/release.keystore

# Keystore password
storePassword=your_store_password

# Key alias
keyAlias=your_key_alias

# Key password
keyPassword=your_key_password
